{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "MinIO - Total Buckets",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{"color": "green", "value": null}] } }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "minio_cluster_bucket_total",
          "legendFormat": "buckets"
        }
      ]
    },
    {
      "title": "MinIO - Capacity (free / total)",
      "type": "bargauge",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "bytes", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{"color": "green", "value": null}] } }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "minio_cluster_capacity_usable_free_bytes",
          "legendFormat": "free"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "minio_cluster_capacity_usable_total_bytes",
          "legendFormat": "total"
        }
      ]
    },
    {
      "title": "PostgreSQL - Active Connections",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "fieldConfig": { "defaults": { "min": 0, "max": 100, "color": { "mode": "thresholds" }, "thresholds": { "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 50}, {"color": "red", "value": 80}] } }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "pg_stat_activity_count",
          "legendFormat": "connections"
        }
      ]
    },
    {
      "title": "PostgreSQL - Database Size",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "bytes", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{"color": "green", "value": null}] } }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "pg_database_size_bytes{datname=\"mediapulse\"}",
          "legendFormat": "mediapulse"
        }
      ]
    },
    {
      "title": "Kafka - Brokers Online",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 6 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}] } }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "kafka_brokers",
          "legendFormat": "brokers"
        }
      ]
    },
    {
      "title": "Kafka - Topic Partitions",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 6 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{"color": "green", "value": null}] } }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "kafka_topic_partitions",
          "legendFormat": "{{topic}}"
        }
      ]
    },
    {
      "title": "Prometheus - Targets Up",
      "type": "stat",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 12 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}] }, "mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}] }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "up",
          "legendFormat": "{{job}}"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["mediapulse", "monitoring"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "MediaPulse - Pipeline Health",
  "uid": "mediapulse-pipeline-health"
}
