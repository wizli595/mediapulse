{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "MinIO - Total Objects",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "minio_bucket_usage_object_total",
          "legendFormat": "{{bucket}}"
        }
      ]
    },
    {
      "title": "MinIO - Bucket Size (bytes)",
      "type": "bargauge",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "minio_bucket_usage_total_bytes",
          "legendFormat": "{{bucket}}"
        }
      ]
    },
    {
      "title": "Kafka - Messages In Per Second",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "rate(kafka_server_brokertopicmetrics_messagesin_total[5m])",
          "legendFormat": "{{topic}}"
        }
      ]
    },
    {
      "title": "PostgreSQL - Active Connections",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "pg_stat_activity_count",
          "legendFormat": "connections"
        }
      ]
    },
    {
      "title": "Prometheus - Targets Up",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "up",
          "legendFormat": "{{job}}"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["mediapulse", "monitoring"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "MediaPulse - Pipeline Health",
  "uid": "mediapulse-pipeline-health"
}
