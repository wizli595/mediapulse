# ===========================================
# MediaPulse — Environment Configuration
# ===========================================
# Copy this file to .env: cp .env.example .env
# Then run: docker compose up -d

# --- MinIO (Data Lake) ---
# Console: http://localhost:9001
# Login: mediapulse / changeme123
MINIO_ROOT_USER=mediapulse
MINIO_ROOT_PASSWORD=changeme123
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET_BRONZE=bronze
MINIO_BUCKET_SILVER=silver
MINIO_BUCKET_GOLD=gold

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_RAW_ARTICLES=raw-articles

# --- PostgreSQL (Data Warehouse) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mediapulse
POSTGRES_USER=mediapulse
POSTGRES_PASSWORD=changeme123

# --- Airflow ---
# UI: http://localhost:8080
# Login: admin / admin
# (credentials created automatically by airflow-init)

# --- Metabase ---
# UI: http://localhost:3000
# First launch: create your account at the setup wizard
# Then add database connection:
#   Type: PostgreSQL
#   Host: postgres | Port: 5432
#   Database: mediapulse
#   User: mediapulse | Password: changeme123

# --- Grafana ---
# UI: http://localhost:3001
# Login: admin / admin
# Prometheus datasource is auto-provisioned

# --- Scraping ---
SCRAPE_INTERVAL_HOURS=1
SCRAPE_USER_AGENT=MediaPulse/1.0 (Academic Research Project)
