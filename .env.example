# ===========================================
# MediaPulse — Environment Configuration
# ===========================================
# Copy this file to .env and fill in values.

# --- MinIO (Data Lake) ---
MINIO_ROOT_USER=mediapulse
MINIO_ROOT_PASSWORD=changeme123
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET_BRONZE=bronze
MINIO_BUCKET_SILVER=silver
MINIO_BUCKET_GOLD=gold

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_RAW_ARTICLES=raw-articles

# --- PostgreSQL (Data Warehouse) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mediapulse
POSTGRES_USER=mediapulse
POSTGRES_PASSWORD=changeme123

# --- Airflow ---
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://mediapulse:changeme123@postgres:5432/airflow

# --- Metabase ---
MB_DB_TYPE=postgres
MB_DB_HOST=postgres
MB_DB_PORT=5432
MB_DB_DBNAME=metabase
MB_DB_USER=mediapulse
MB_DB_PASS=changeme123

# --- Scraping ---
SCRAPE_INTERVAL_HOURS=1
SCRAPE_USER_AGENT=MediaPulse/1.0 (Academic Research Project)
